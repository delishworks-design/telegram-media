{
  "name": "telegram-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Telegram (MTProto) media library backend and streaming API.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "telegram-login": "tsx scripts/telegram-login.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "big-integer": "^1.6.52",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "teleproto": "^1.230.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/big-integer": "^0.0.35",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
