# ---------------------------------------------------------------------------
# telegram-media — environment template. Copy to .env and fill in.
# NEVER commit .env. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port to listen on (>= 1024; the container cannot bind privileged ports).
PORT=8787
# Bind address. Use 127.0.0.1 behind a reverse proxy, or 0.0.0.0 in a container.
HOST=0.0.0.0
# Public origin this API is reachable at (no trailing slash). Used to build
# absolute playback URLs and for cookie Secure detection behind a proxy.
PUBLIC_BASE_URL=https://media.example.com
# Set to "true" only when serving over HTTPS (directly or via a trusted proxy)
# so session cookies get the Secure flag.
COOKIE_SECURE=true
# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty to allow same-origin only.
CORS_ORIGINS=

# --- Secrets ----------------------------------------------------------------
# 32-byte base64 key used to encrypt the Telegram session and API hash at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates all stored Telegram session material.
MASTER_KEY=

# HMAC key for signing short-lived playback tokens.
# Generate the same way as MASTER_KEY.
PLAYBACK_TOKEN_SECRET=

# --- Authorized users (exactly two for personal use) ------------------------
# JSON array of users. Passwords are scrypt hashes, never plaintext.
# Generate a hash with:  pnpm hash-password
# Example (placeholders):
AUTH_USERS=[{"username":"owner","passwordHash":"scrypt$16384$8$1$<salt-b64>$<hash-b64>"},{"username":"partner","passwordHash":"scrypt$16384$8$1$<salt-b64>$<hash-b64>"}]

# --- Telegram API credentials ----------------------------------------------
# OPTIONAL to pre-seed. If left blank you can complete the setup through the
# UI (/api/telegram/*) or the CLI (pnpm telegram-login). api_hash is encrypted
# at rest with MASTER_KEY before it is written to the database.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone number in international format, e.g. +15551234567
TELEGRAM_PHONE=
# Target private channel. Accepts a numeric id (e.g. -1001234567890) or an
# @username of a channel you own. Leave blank to have the setup flow create a
# new private channel named TELEGRAM_CHANNEL_TITLE.
TELEGRAM_CHANNEL=
TELEGRAM_CHANNEL_TITLE=Media Vault

# --- Storage / limits -------------------------------------------------------
# SQLite file for sessions + media metadata (NOT the video binaries).
DATABASE_PATH=./data/media.sqlite
# Directory for in-progress chunked uploads.
UPLOAD_TMP_DIR=./tmp/uploads
# Max accepted upload size in bytes (default 2 GiB).
MAX_UPLOAD_BYTES=2147483648
# Chunk size for the resumable upload protocol, in bytes (default 8 MiB).
CHUNK_SIZE_BYTES=8388608
# Max concurrent Telegram send operations (keep at 1 for safe sequencing).
UPLOAD_CONCURRENCY=1
# Telegram chunk request size when streaming downloads (bytes, default 1 MiB).
STREAM_CHUNK_BYTES=1048576
# How long a signed playback token stays valid, in seconds.
PLAYBACK_TOKEN_TTL=3600
# Session cookie lifetime in seconds (default 14 days).
SESSION_TTL=1209600

# --- Trusted proxy ----------------------------------------------------------
# Number of reverse proxies in front of the app (for correct client IPs).
TRUST_PROXY=1
# Log level: error | warn | info | debug
LOG_LEVEL=info
