# ---------------------------------------------------------------------------
# Production template for the Docker + Caddy stack. Copy to .env and fill in.
# This is what `docker compose` reads. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Domain / TLS (read by docker-compose and Caddy) ------------------------
# A domain whose DNS A/AAAA record points at this server. Caddy gets a
# Let's Encrypt certificate for it automatically.
DOMAIN=media.example.com
# Address used for Let's Encrypt expiry notices.
EMAIL=you@example.com

# --- Server -----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Must match DOMAIN, with https:// and no trailing slash.
PUBLIC_BASE_URL=https://media.example.com
# true because Caddy terminates HTTPS for us.
COOKIE_SECURE=true
CORS_ORIGINS=

# --- Secrets (generate fresh: see DEPLOY.md) --------------------------------
MASTER_KEY=
PLAYBACK_TOKEN_SECRET=

# --- Authorized users (exactly two) -----------------------------------------
# Generate each hash with:  docker compose run --rm app node -e "import('./dist/util/crypto.js').then(m=>console.log(m.hashPassword(process.argv[1])))" 'your-password'
# or locally with:  pnpm hash-password
AUTH_USERS=[{"username":"owner","passwordHash":"scrypt$16384$8$1$<salt>$<hash>"},{"username":"partner","passwordHash":"scrypt$16384$8$1$<salt>$<hash>"}]

# --- Telegram API credentials (optional; can also be done in the UI) --------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNEL=
TELEGRAM_CHANNEL_TITLE=Media Vault

# --- Storage / limits (paths point at the mounted volume) -------------------
# Preferred on Docker/VM hosts with a persistent volume: SQLite on the volume.
DATABASE_PATH=/data/media.sqlite
# Alternative: a managed PostgreSQL URL. When set it overrides DATABASE_PATH.
# Use this on hosts without a free persistent disk (e.g. Northflank free tier).
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=5
UPLOAD_TMP_DIR=/data/uploads
MAX_UPLOAD_BYTES=2147483648
CHUNK_SIZE_BYTES=8388608
UPLOAD_CONCURRENCY=1
STREAM_CHUNK_BYTES=1048576
PLAYBACK_TOKEN_TTL=3600
SESSION_TTL=1209600

# --- Trusted proxy (Caddy is one hop in front) ------------------------------
TRUST_PROXY=1
LOG_LEVEL=info
